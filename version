--#region EasyMoneyOnly

local function J(value)
    if Utils and Utils.Joaat then
        return Utils.Joaat(value)
    end

    local hash = 0
    for i = 1, #value do
        hash = hash + value:byte(i)
        hash = hash + ((hash << 10) & 0xFFFFFFFF)
        hash = hash ~ (hash >> 6)
    end
    hash = hash + ((hash << 3) & 0xFFFFFFFF)
    hash = hash ~ (hash >> 11)
    hash = hash + ((hash << 15) & 0xFFFFFFFF)
    return hash & 0xFFFFFFFF
end

