local function AddFeature(hash, name, desc, callback, ftype)
    local ftypeToUse = ftype or ((eFeatureType and eFeatureType.Button) or 0)
    if _AddFeature then
        _AddFeature(hash, name, ftypeToUse, desc, callback)
    elseif FeatureMgr and FeatureMgr.AddFeature then
        FeatureMgr.AddFeature(hash, name, ftypeToUse, desc, callback)
    end
end

local function AddTabFeature(tab, hash)
    if _addFeature then
        _addFeature(tab, hash)
    elseif tab and tab.AddFeature then
        tab:AddFeature(hash)
    end
end

AddFeature(
    EasyMoney.Instant.Give30m.hash,
    EasyMoney.Instant.Give30m.name,
    EasyMoney.Instant.Give30m.desc,
    EasyMoney.Instant.Give30m.func,
    EasyMoney.Instant.Give30m.type
)

if ClickGUI and ClickGUI.AddTab then
    local function RenderEasyMoneyClickGUI()
        if ClickGUI.BeginCustomChildWindow("?") then
            ClickGUI.RenderFeature(EasyMoney.Instant.Give30m.hash)
            ClickGUI.EndCustomChildWindow()
        end
    end

    ClickGUI.AddTab("SafeMoneyLua", RenderEasyMoneyClickGUI)
end

if ListGUI and ListGUI.GetRootTab then
    local root = ListGUI.GetRootTab()
    if root then
        local easyMoneyTab = root:AddSubTab("SafeMoneyLua", "?")
        if easyMoneyTab then
            AddTabFeature(easyMoneyTab, EasyMoney.Instant.Give30m.hash)
        end
    end
end

