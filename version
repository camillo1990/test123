local function LogInfoColor(message, color)
    if Logger and Logger.Log then
        Logger.Log(color or 0, "SafeMoneyLua", message)
    elseif Logger and Logger.LogInfo then
        Logger.LogInfo(message)
    elseif SilentLogger and SilentLogger.LogInfo then
        SilentLogger.LogInfo(message)
    else
        print(message)
    end
end

local function LogInfoGreen(message)
    LogInfoColor(message, (eLogColor and eLogColor.LIGHTGREEN) or 0)
end

local function LogInfoYellow(message)
    LogInfoColor(message, (eLogColor and eLogColor.YELLOW) or 0)
end

local function LogInfoPink(message)
    LogInfoColor(message, (eLogColor and eLogColor.LIGHTMAGENTA) or 0)
end

